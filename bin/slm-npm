#!/usr/bin/env node
/**
 * SuperLocalMemory V3 - NPM Global CLI Wrapper
 *
 * Copyright (c) 2026 Varun Pratap Bhardwaj / Qualixar
 * Licensed under MIT License (see LICENSE file)
 * Repository: https://github.com/qualixar/superlocalmemory
 */

const { spawnSync } = require('child_process');
const path = require('path');
const fs = require('fs');
const {
    findPythonCommand,
    resolvePinnedPython,
    getSlmHome,
} = require('../scripts/python_runtime');

// V3 package root (where src/superlocalmemory/ lives)
const PKG_ROOT = path.join(__dirname, '..');
const SRC_DIR = path.join(PKG_ROOT, 'src');
const CLI_MODULE = 'superlocalmemory.cli.main';

// Ensure ~/.superlocalmemory/ exists
const SLM_HOME = getSlmHome();
if (!fs.existsSync(SLM_HOME)) {
    fs.mkdirSync(SLM_HOME, { recursive: true });
}

function resolvePythonParts() {
    const pinned = resolvePinnedPython(SLM_HOME);
    if (pinned && Array.isArray(pinned.parts)) return pinned.parts;
    return findPythonCommand();
}

// Find Python (prefer pinned postinstall runtime)
const pythonParts = resolvePythonParts();
if (!pythonParts) {
    console.error('Error: Python 3.11+ not found.');
    console.error('Install Python from https://python.org/downloads/');
    process.exit(1);
}

// Handle --version directly from package.json (Python importlib.metadata
// fails when running via PYTHONPATH instead of pip install)
const args = process.argv.slice(2);
if (args.includes('--version') || args.includes('-v')) {
    const pkg = require(path.join(PKG_ROOT, 'package.json'));
    console.log(`superlocalmemory ${pkg.version}`);
    process.exit(0);
}

// Launch V3 CLI via Python module
const result = spawnSync(pythonParts[0], [
    ...pythonParts.slice(1),
    '-m', CLI_MODULE, ...args
], {
    stdio: 'inherit',
    env: {
        ...process.env,
        PYTHONPATH: SRC_DIR + (process.env.PYTHONPATH ? path.delimiter + process.env.PYTHONPATH : ''),
        // Prevent PyTorch Metal/MPS GPU memory reservation on Apple Silicon.
        // Without these, macOS Activity Monitor shows 3-6 GB for a 40 MB process.
        PYTORCH_MPS_HIGH_WATERMARK_RATIO: '0.0',
        PYTORCH_MPS_MEM_LIMIT: '0',
        PYTORCH_ENABLE_MPS_FALLBACK: '1',
        TOKENIZERS_PARALLELISM: 'false',
        TORCH_DEVICE: 'cpu',
        CUDA_VISIBLE_DEVICES: '',
    },
});

process.exit(result.status || 0);
